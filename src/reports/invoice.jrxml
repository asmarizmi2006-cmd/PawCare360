			<staticText><reportElement x="12" y="30" width="300" height="14" forecolor="#FFFFFF"/><text><![CDATA[Pet care & clinic management]]></text></staticText>
			<staticText><reportElement x="380" y="10" width="127" height="30" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font size="20" isBold="true"/></textElement><text><![CDATA[INVOICE]]></text></staticText>
			<staticText><reportElement x="0" y="62" width="70" height="14"/><textElement><font isBold="true"/></textElement><text><![CDATA[Invoice No:]]></text></staticText>
			<textField><reportElement x="70" y="62" width="150" height="14"/><textFieldExpression><![CDATA["#" + $P{INV_NO}]]></textFieldExpression></textField>
